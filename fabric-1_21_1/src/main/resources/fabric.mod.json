{
  "schemaVersion": 1,
  "id": "lootr_styled",
  "version": "${version}",
  "name": "Lootr: Styled",
  "description": "Client-side model and artwork compatibility for Lootr.",
  "authors": [
    "inherent.design contributors"
  ],
  "license": "Apache-2.0 (code); artwork terms in NOTICE",
  "environment": "client",
  "entrypoints": {
    "client": [
      "design.inherent.lootr_styled.fabric.LootrStyledFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabricLoaderMinimum}",
    "minecraft": "1.21.1",
    "java": ">=21",
    "lootr": ">=1.21.1-1.11.38.127",
    "fabric-command-api-v2": "*",
    "fabric-renderer-api-v1": "*",
    "reform": "${reformVersion}"
  },
  "mixins": [
    "lootr_styled.mixins.json",
    "lootr_styled.fabric.mixins.json"
  ]
}
